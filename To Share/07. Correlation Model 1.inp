TITLE: Correlations among the PFC-S,
BIS/BAS, ERC, and BDI-II;

DATA:
FILE = "C:\Users\nicol\Box\
01. Nicolas Dissertation\Data\
mi_data_p1_mplus\
mi_data_p1_mplus__IMP_LIST.txt";
! Update the file path to reflect where the
! imputed data can be found

TYPE = IMPUTATION;

VARIABLE:
NAMES = age sex pfc01-pfc23 bdi bis bas 
bas_drv bas_fun bas_rew erc_er erc_ln
mca_glt brief_gec ks_anhed;
MISSING ARE ALL(999);

USEVARIABLES = pfc01-pfc15 pfc17-pfc23
bdi bis bas bas_drv bas_fun bas_rew erc_er
erc_ln;
CATEGORICAL = pfc01-pfc15 pfc17-pfc23;

ANALYSIS:
ESTIMATOR = WLSMV;
ROTATION = TARGET (orthogonal);

MODEL:
! General Factor
G BY pfc01* pfc02 pfc03 pfc04 pfc05 pfc06
pfc07 pfc08 pfc09 pfc10 pfc11 pfc12 pfc13
pfc14 pfc15 pfc17 pfc18 pfc19 pfc20 pfc21
pfc22 pfc23 (*1);

! Social and Behavioral Anhedonia
SBA BY pfc01* pfc03 pfc05 pfc09 pfc10 
pfc17 pfc22 ! pfc17, pfc22 cross-loadings
pfc02~0 pfc04~0 pfc06~0 pfc07~0 pfc08~0 
pfc11~0 pfc12~0 pfc13~0 pfc14~0 pfc15~0 
pfc18~0 pfc19~0 pfc20~0 pfc21~0 pfc23~0 (*1);

! Emotional and Behavioral Dysregulation
EBD BY pfc04* pfc06 pfc07 pfc08 pfc11 pfc14 
pfc21 pfc22 pfc23 ! pfc21-pfc23 cross-loadings
pfc01~0 pfc02~0 pfc03~0 pfc05~0 pfc09~0 
pfc10~0 pfc12~0 pfc13~0 pfc15~0 pfc17~0 
pfc18~0 pfc19~0 pfc20~0 (*1);

! Excessive Guilt and Sadness
EGS BY pfc02* pfc12 pfc13 pfc15 
pfc17 pfc18 pfc19 pfc20 pfc21 ! pfc17, pfc21 cross-loadings
pfc01~0 pfc03~0 pfc04~0 pfc05~0 pfc06~0 
pfc07~0 pfc08~0 pfc09~0 pfc10~0 pfc11~0 
pfc14~0 pfc22~0 pfc23~0 (*1);

! Residual correlations freed for items with similar wording from SBA
pfc01 WITH pfc03;
! pfc01 WITH pfc05; removed because p > .05
pfc01 WITH pfc09;
! pfc03 WITH pfc05; removed because p > .05
pfc03 WITH pfc09;
pfc05 WITH pfc09;

! Factor variances held at 1
G@1;
SBA@1;
EBD@1;
EGS@1;

! Correlations between factors held at 0 using (orthogonal) above

! Create "latent variables" of the observed measures for correlations
bdi_lv BY bdi; bdi@0;
bis_lv BY bis; bis@0;
bas_lv BY bas; bas@0;
drv_lv BY bas_drv; bas_drv@0;
fun_lv BY bas_fun; bas_fun@0;
rew_lv BY bas_rew; bas_rew@0;
er_lv BY erc_er; erc_er@0;
ln_lv BY erc_ln; erc_ln@0;

! Correlations between PFC-S and observed measures (BIS/BAS, ERC, BDI-II)
! Estimated by default

OUTPUT:
SAMPSTAT STDYX RESIDUAL TECH9;